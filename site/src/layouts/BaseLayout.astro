---
import { SITE_URL, INDEXABLE } from '~/config/site';
import '~/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'vizzle — Code Diagrams for Git', description = 'Interactive diagrams that parse your codebase and sync with git.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    {!INDEXABLE && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>

    <link rel="canonical" href={SITE_URL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
  }
</style>
