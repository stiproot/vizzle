# Rust
/target
**/*.rs.bk

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# uv
.python-version

# Node (only used for ad-hoc mermaid rendering)
node_modules/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Ad-hoc generated diagrams anywhere outside examples/
*.mmd
*.mmd.svg
*.mmd.png
!examples/*.mmd
# Diagrams written into the repo root (the natural cwd for `vizzle -o out.html`).
# Root-anchored, so committed pages under examples/ and the HTML templates
# under packages/ are unaffected.
/*.html
/*.svg
/*.png
